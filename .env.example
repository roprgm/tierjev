AI_GATEWAY_API_KEY=
# Optional locally. On Vercel, the Upstash Marketplace integration sets both (vercel env pull .env.local).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# X bot (bot/README.md). The app's API Key Secret verifies webhook signatures and answers the CRC challenge.
X_CONSUMER_SECRET=
# OAuth 2.0 client of the same app.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Bot account (@tierjev) tokens from the developer console; the refresh token rotates and lives in Redis.
X_REFRESH_TOKEN=
X_USER_ID=
X_USERNAME=
# Optional base64 32-byte key (`openssl rand -base64 32`) that encrypts the tokens stored in Redis.
X_ENCRYPTION_KEY=
# Local dev only: a two-hour access token instead of the refresh token, so local runs never rotate production's token.
X_USER_ACCESS_TOKEN=
# App-only Bearer Token, used only by `bun run bot:webhook`.
X_BEARER_TOKEN=
# Set by the Upstash integration; the bot's state lives here (dedupe, locks, OAuth token, answer log).
REDIS_URL=

# Set by Vercel Cron and verified by /api/cron/x so only the scheduler can trigger the mention sweep.
CRON_SECRET=
